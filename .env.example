# =============================================================================
# TEMPLATE KONFIGURASI SUPABASE MASTER HUB
# Salin file ini menjadi .env.local dan isi dengan kredensial Supabase Master Anda:
# cp .env.example .env.local
# =============================================================================

# 1. Supabase Master Project URL (Contoh: https://your-project.supabase.co)
VITE_MASTER_SUPABASE_URL=

# 2. Supabase Master Anon Key (Public Key)
VITE_MASTER_SUPABASE_ANON_KEY=

# 3. Supabase Master Service Role Key (Secret Key, Opsional)
VITE_MASTER_SUPABASE_SERVICE_ROLE_KEY=
